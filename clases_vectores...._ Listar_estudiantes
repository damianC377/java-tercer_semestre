package base_estudiante;

/**
 *
 * @author ESTUDIANTE
 */
public class estudiante {
    private String code;
    private String nombre;
    private int edad;
    private double nota;
    
    public estudiante(String code, String nombre, int edad, double nota){
        this.code = code;
        this.nombre = nombre;
        this.edad = edad;
        this.nota = nota;
        
        System.out.println("El estudiante ha sido creado :D");
    }
    
    public void setnombre(String nombre){
        this.nombre = nombre;
    }
    
    public String getnombre(){
        return nombre;
    }
    
    public void setcode(String code){
        this.code = code;
    }
    
    public String getcode(){
        return code;
    }
    
    public void setedad(int edad){
        this.edad = edad;
    }
    
    public int getedad(){
        return edad;
    }
    
    public void setnota(double nota){
        this.nota = nota;
    }
    
   public double getnota(){
       return nota;
   }

    @Override
    public String toString() {
        return "estudiante{" + "code=" + code + ", nombre=" + nombre + ", edad=" + edad + ", nota=" + nota + '}';
    }
   
   
}


